# Datos de conexion a tu base de datos MySQL
DB_HOST=localhost
# Usuario de MySQL (normalmente "root" en XAMPP/local)
DB_USER=root
# Contraseña de ese usuario de MySQL (la nueva que rotaste)
DB_PASS=
# Nombre de tu base de datos
DB_NAME=cyber_core

# Correo de Gmail que usa PHPMailer para enviar (recuperacion, validacion, etc.)
MAIL_USERNAME=
# App Password de Gmail (la nueva que generaste, NO tu contraseña normal de Gmail)
MAIL_PASSWORD=
# Nombre que va a aparecer como remitente en los correos
MAIL_FROM_NAME="Cyber Core"

# Datos de tu app en pusher.com, pestaña "App Keys"
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
# El cluster que elegiste al crear la app (ej: us2, sa1)
PUSHER_CLUSTER=us2

# Token permanente del usuario del sistema que generaste en Meta Business
META_WHATSAPP_TOKEN=
# El Phone Number ID que te da Meta en WhatsApp > Configuracion de la API (no es un numero de telefono real)
META_PHONE_NUMBER_ID=
# Nombre de la plantilla aprobada que vas a usar ("hello_world" para probar, o la tuya una vez aprobada)
META_TEMPLATE_NAME=hello_world
# Idioma de esa plantilla (en_US para hello_world, es para la tuya en español)
META_TEMPLATE_LANG=en_US